[Unit]
Description=Indcool CRM FastAPI service
After=network.target

[Service]
User=www-data
Group=www-data
WorkingDirectory=/var/www/indcool/api
EnvironmentFile=/var/www/indcool/api/.env
ExecStart=/var/www/indcool/api/venv/bin/uvicorn app.main:app --host 127.0.0.1 --port 8000
Restart=always
RestartSec=5

[Install]
WantedBy=multi-user.target
